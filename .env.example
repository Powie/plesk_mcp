# Plesk Instance Configuration
# You can configure multiple Plesk instances by using different prefixes

# Instance 1 (default)
PLESK_URL=https://your-plesk-server.com
PLESK_API_KEY=your-api-key-here

# Instance 2 (optional)
PLESK_2_URL=https://your-second-plesk-server.com
PLESK_2_API_KEY=your-second-api-key

# Instance 3 (optional)
PLESK_3_URL=https://your-third-plesk-server.com
PLESK_3_API_KEY=your-third-api-key

# You can add as many instances as needed by following the pattern:
# PLESK_N_URL and PLESK_N_API_KEY

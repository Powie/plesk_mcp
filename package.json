{
  "name": "plesk-mcp-server",
  "version": "0.2.0",
  "description": "MCP Server for Plesk REST API - supports multiple Plesk instances",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "plesk-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "plesk",
    "model-context-protocol",
    "hosting"
  ],
  "author": "Powie",
  "license": "GPL3",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}

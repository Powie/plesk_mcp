{
  "name": "plesk-mcp-server",
  "version": "0.10.0",
  "description": "MCP Server for Plesk REST API - supports multiple Plesk instances",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "plesk-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepare": "npm run build",
    "test": "node --test tests/api-key.cjs tests/e2e.mjs"
  },
  "keywords": [
    "mcp",
    "plesk",
    "model-context-protocol",
    "hosting"
  ],
  "author": "Powie",
  "license": "GPL3",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "dotenv": "^16.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
